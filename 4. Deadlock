
#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define N 5

sem_t forks[N], room;

void *philosopher(void *arg)
{
    int i = *(int *)arg;

    printf("Philosopher %d thinking\n", i);
    sleep(1);

    sem_wait(&room);
    sem_wait(&forks[i]);
    sem_wait(&forks[(i+1)%N]);

    printf("Philosopher %d eating\n", i);
    sleep(1);

    sem_post(&forks[i]);
    sem_post(&forks[(i+1)%N]);
    sem_post(&room);

    printf("Philosopher %d finished\n", i);
    return NULL;
}

int main()
{
    pthread_t p[N];
    int id[N];

    for(int i=0; i<N; i++)
        sem_init(&forks[i], 0, 1);

    sem_init(&room, 0, N-1);

    for(int i=0; i<N; i++)
    {
        id[i] = i;
        pthread_create(&p[i], NULL, philosopher, &id[i]);
    }

    for(int i=0; i<N; i++)
        pthread_join(p[i], NULL);

    for(int i=0; i<N; i++)
        sem_destroy(&forks[i]);

    sem_destroy(&room);
    return 0;
}
