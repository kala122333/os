
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

void sort(int a[], int n)
{
    int i, j, temp;

    for(i = 0; i < n-1; i++)
        for(j = 0; j < n-i-1; j++)
            if(a[j] > a[j+1])
            {
                temp = a[j];
                a[j] = a[j+1];
                a[j+1] = temp;
            }
}

int main()
{
    int a[20], n, i, pid;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    // FORK AND WAIT DEMONSTRATION
    pid = fork();

    if(pid == 0)
    {
        printf("\nChild process sorting:\n");
        sort(a, n);

        for(i = 0; i < n; i++)
            printf("%d ", a[i]);

        printf("\nChild completed.\n");
        exit(0);
    }
    else if(pid > 0)
    {
        printf("\nParent process sorting:\n");
        sort(a, n);

        for(i = 0; i < n; i++)
            printf("%d ", a[i]);

        wait(NULL);

        printf("\nParent completed after waiting.\n");
    }

    // ZOMBIE PROCESS DEMONSTRATION
    pid = fork();

    if(pid == 0)
    {
        printf("\nZombie demo: Child exiting.\n");
        exit(0);
    }
    else if(pid > 0)
    {
        printf("Zombie demo: Parent sleeping for 10 seconds.\n");
        sleep(10);
        wait(NULL);
    }

    // ORPHAN PROCESS DEMONSTRATION
    pid = fork();

    if(pid == 0)
    {
        sleep(5);

        printf("\nOrphan Child PID: %d\n", getpid());
        printf("New Parent PID: %d\n", getppid());
    }
    else if(pid > 0)
    {
        printf("\nOrphan demo: Parent exiting.\n");
        exit(0);
    }

    return 0;
}
